[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/end.gd" id="1_end"]
[ext_resource type="Texture2D" path="res://Assets/sprites/backgroundColorFall.png" id="2_bg"]
[ext_resource type="FontFile" path="res://Assets/fonts/PixelOperator8-Bold.ttf" id="3_bold"]
[ext_resource type="FontFile" path="res://Assets/fonts/PixelOperator8.ttf" id="4_font"]
[ext_resource type="AudioStream" path="res://Assets/sounds/power_up.wav" id="5_win"]

[node name="End" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_end")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_bg")
expand_mode = 1
stretch_mode = 6

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 12
theme_override_fonts/font = ExtResource("3_bold")
theme_override_font_sizes/font_size = 48
text = "THE END"
horizontal_alignment = 1

[node name="Text" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 18
text = "you bounced back!
thanks for playing :)

made by Aflah, Finan and Amjad"
horizontal_alignment = 1

[node name="Back" type="Button" parent="Center/Box"]
custom_minimum_size = Vector2(250, 50)
layout_mode = 2
size_flags_horizontal = 4
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 24
text = "Menu"

[node name="WinSound" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_win")
autoplay = true

[connection signal="pressed" from="Center/Box/Back" to="." method="_on_back_pressed"]
