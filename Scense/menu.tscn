[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://Assets/sprites/backgroundColorGrass.png" id="2_bg"]
[ext_resource type="FontFile" path="res://Assets/fonts/PixelOperator8-Bold.ttf" id="3_bold"]
[ext_resource type="FontFile" path="res://Assets/fonts/PixelOperator8.ttf" id="4_font"]
[ext_resource type="AudioStream" path="res://Assets/music/time_for_adventure.mp3" id="5_music"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
texture = ExtResource("2_bg")
expand_mode = 1
stretch_mode = 6

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 12
theme_override_fonts/font = ExtResource("3_bold")
theme_override_font_sizes/font_size = 48
text = "BOUNCY CORPSE"
horizontal_alignment = 1

[node name="Start" type="Button" parent="Center/Box"]
custom_minimum_size = Vector2(250, 50)
layout_mode = 2
size_flags_horizontal = 4
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 24
text = "Start"

[node name="Quit" type="Button" parent="Center/Box"]
custom_minimum_size = Vector2(250, 50)
layout_mode = 2
size_flags_horizontal = 4
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 24
text = "Quit"

[node name="Help" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_fonts/font = ExtResource("4_font")
theme_override_font_sizes/font_size = 14
text = "A/D = move   SPACE = jump   R = restart   ESC = menu"
horizontal_alignment = 1

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("5_music")
autoplay = true
bus = &"music"

[connection signal="pressed" from="Center/Box/Start" to="." method="_on_start_pressed"]
[connection signal="pressed" from="Center/Box/Quit" to="." method="_on_quit_pressed"]
